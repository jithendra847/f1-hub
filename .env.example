# Environment & General Settings
ENVIRONMENT=development
CURRENT_F1_SEASON=2026
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-f1-2026-secret-key

# Service Ports
PORT_FRONTEND=3000
PORT_BACKEND=8000
PORT_POSTGRES=5432

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=f1_user
POSTGRES_PASSWORD=f1_password
POSTGRES_DB=f1_analytics
DATABASE_URL=postgresql+asyncpg://f1_user:f1_password@postgres:5432/f1_analytics


# Provider Capabilities & URLs
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
OPENF1_BASE_URL=https://api.openf1.org/v1
FASTF1_CACHE_DIR=/tmp/fastf1_cache

# API Keys (Optional / External)
WEATHER_API_KEY=
NEWS_API_KEY=

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]
